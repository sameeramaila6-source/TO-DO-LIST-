#include <stdio.h>
#include <string.h>

int main() {
    char tasks[10][100];
    int n = 0, choice;

    while (1) {
        printf("\n1. Add Task\n2. View Tasks\n3. Exit\n");
        printf("Enter choice: ");
        scanf("%d", &choice);
        getchar();

        if (choice == 1) {
            printf("Enter task: ");
            fgets(tasks[n], 100, stdin);
            tasks[n][strcspn(tasks[n], "\n")] = 0;
            n++;
        }
        else if (choice == 2) {
            for (int i = 0; i < n; i++)
                printf("%d. %s\n", i + 1, tasks[i]);
        }
        else if (choice == 3) {
            break;
        }
        else {
            printf("Invalid choice!\n");
        }
    }

    return 0;
}
